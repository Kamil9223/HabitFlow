@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface">
        <MudText Typo="Typo.h6" Class="ml-3">
            <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">
                HabitFlow
            </MudLink>
        </MudText>
        <MudSpacer />
        <MudButton Href="/auth/login" Variant="Variant.Text" Color="Color.Primary" Class="mr-2">
            Logowanie
        </MudButton>
        <MudButton Href="/auth/register" Variant="Variant.Filled" Color="Color.Primary">
            Rejestracja
        </MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
