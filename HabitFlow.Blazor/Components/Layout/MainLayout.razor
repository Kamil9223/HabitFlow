@inherits LayoutComponentBase
@using HabitFlow.Blazor.Components.Shared
@rendermode InteractiveServer

<MudThemeProvider Theme="@ProductivityDarkTheme.Theme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    private bool _isDarkMode = true;
}

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <div style="display: flex; justify-content: flex-end; align-items: center; width: 100%; gap: 8px;">
                <AuthorizeView>
                    <Authorized>
                        <NotificationsBell />
                        <MudButton Href="/auth/logout"
                                   Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Logout">
                            Wyloguj
                        </MudButton>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Href="/auth/login"
                                   Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Login">
                            Zaloguj się
                        </MudButton>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            <EmailConfirmationGate />
            @Body
        </article>
    </main>
</div>

<BottomNav />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>