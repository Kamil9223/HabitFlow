@* Komponent dzwonka powiadomień z licznikiem nowych w top bar *@
@rendermode InteractiveServer

<MudIconButton Icon="@Icons.Material.Filled.Notifications"
               Color="Color.Inherit"
               Href="/notifications"
               Title="Powiadomienia"
               aria-label="Powiadomienia">
    @if (_unreadCount > 0)
    {
        <MudBadge Content="@_unreadCount" 
                  Color="Color.Error" 
                  Overlap="true" 
                  Class="mx-2">
        </MudBadge>
    }
</MudIconButton>

