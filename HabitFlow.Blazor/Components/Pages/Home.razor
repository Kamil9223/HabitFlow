@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>HabitFlow</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Zalogowany użytkownik - przekieruj do /today
            Navigation.NavigateTo("/today", replace: true);
        }
        else
        {
            // Niezalogowany użytkownik - przekieruj do /auth/login
            Navigation.NavigateTo("/auth/login", replace: true);
        }
    }
}