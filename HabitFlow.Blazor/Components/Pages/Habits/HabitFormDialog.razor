@using HabitFlow.Blazor.Components.Pages.Habits.Models
@using HabitFlow.Client
@using MudBlazor

<MudDialog>
    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            
            <MudStack Spacing="3">
                <MudTextField @bind-Value="Model.Title"
                              Label="Tytuł nawyku"
                              Required="true"
                              Counter="80"
                              MaxLength="80"
                              Immediate="true"
                              For="@(() => Model.Title)" />

                <MudTextField @bind-Value="Model.Description"
                              Label="Opis (opcjonalny)"
                              Lines="3"
                              Counter="280"
                              MaxLength="280"
                              Immediate="true"
                              For="@(() => Model.Description)" />

                <MudSelect @bind-Value="Model.Type"
                           Label="Typ nawyku"
                           Required="true"
                           For="@(() => Model.Type)">
                    <MudSelectItem Value="@HabitType.Start">Buduj (Build)</MudSelectItem>
                    <MudSelectItem Value="@HabitType.Stop">Rzuć (Stop)</MudSelectItem>
                </MudSelect>

                <MudSelect Value="@Model.CompletionMode"
                           ValueChanged="OnCompletionModeChanged"
                           Label="Tryb uzupełniania"
                           Required="true"
                           For="@(() => Model.CompletionMode)"
                           T="CompletionMode">
                    <MudSelectItem Value="@CompletionMode.Binary">Tak/Nie (Binary)</MudSelectItem>
                    <MudSelectItem Value="@CompletionMode.Quantitative">Ilościowy (Quantitative)</MudSelectItem>
                </MudSelect>

                @if (Model.CompletionMode == CompletionMode.Quantitative)
                {
                    <MudStack Row="true" Spacing="2">
                        <MudNumericField T="int?" @bind-Value="Model.TargetValue"
                                         Label="Liczba powtórzeń"
                                         Min="1"
                                         Max="100"
                                         Required="true"
                                         For="@(() => Model.TargetValue)"
                                         Style="flex: 2;" />
                        
                        <MudTextField @bind-Value="Model.TargetUnit"
                                      Label="Jednostka (opcjonalna)"
                                      MaxLength="20"
                                      Placeholder="np. km, razy"
                                      For="@(() => Model.TargetUnit)"
                                      Style="flex: 1;" />
                    </MudStack>
                }

                <MudText Typo="Typo.subtitle2" Class="mt-2">Dni tygodnia</MudText>
                <MudChipSet T="DayOfWeek">
                    <MudChip T="DayOfWeek"
                             Variant="@(SelectedDays.Contains(DayOfWeek.Monday) ? Variant.Filled : Variant.Outlined)"
                             Color="@(SelectedDays.Contains(DayOfWeek.Monday) ? Color.Primary : Color.Default)"
                             OnClick="() => ToggleDay(DayOfWeek.Monday)"
                             DisableRipple="true"
                             Class="habit-day-chip"
                             Size="Size.Small">Pn</MudChip>
                    <MudChip T="DayOfWeek"
                             Variant="@(SelectedDays.Contains(DayOfWeek.Tuesday) ? Variant.Filled : Variant.Outlined)"
                             Color="@(SelectedDays.Contains(DayOfWeek.Tuesday) ? Color.Primary : Color.Default)"
                             OnClick="() => ToggleDay(DayOfWeek.Tuesday)"
                             DisableRipple="true"
                             Class="habit-day-chip"
                             Size="Size.Small">Wt</MudChip>
                    <MudChip T="DayOfWeek"
                             Variant="@(SelectedDays.Contains(DayOfWeek.Wednesday) ? Variant.Filled : Variant.Outlined)"
                             Color="@(SelectedDays.Contains(DayOfWeek.Wednesday) ? Color.Primary : Color.Default)"
                             OnClick="() => ToggleDay(DayOfWeek.Wednesday)"
                             DisableRipple="true"
                             Class="habit-day-chip"
                             Size="Size.Small">Śr</MudChip>
                    <MudChip T="DayOfWeek"
                             Variant="@(SelectedDays.Contains(DayOfWeek.Thursday) ? Variant.Filled : Variant.Outlined)"
                             Color="@(SelectedDays.Contains(DayOfWeek.Thursday) ? Color.Primary : Color.Default)"
                             OnClick="() => ToggleDay(DayOfWeek.Thursday)"
                             DisableRipple="true"
                             Class="habit-day-chip"
                             Size="Size.Small">Czw</MudChip>
                    <MudChip T="DayOfWeek"
                             Variant="@(SelectedDays.Contains(DayOfWeek.Friday) ? Variant.Filled : Variant.Outlined)"
                             Color="@(SelectedDays.Contains(DayOfWeek.Friday) ? Color.Primary : Color.Default)"
                             OnClick="() => ToggleDay(DayOfWeek.Friday)"
                             DisableRipple="true"
                             Class="habit-day-chip"
                             Size="Size.Small">Pt</MudChip>
                    <MudChip T="DayOfWeek"
                             Variant="@(SelectedDays.Contains(DayOfWeek.Saturday) ? Variant.Filled : Variant.Outlined)"
                             Color="@(SelectedDays.Contains(DayOfWeek.Saturday) ? Color.Primary : Color.Default)"
                             OnClick="() => ToggleDay(DayOfWeek.Saturday)"
                             DisableRipple="true"
                             Class="habit-day-chip"
                             Size="Size.Small">Sob</MudChip>
                    <MudChip T="DayOfWeek"
                             Variant="@(SelectedDays.Contains(DayOfWeek.Sunday) ? Variant.Filled : Variant.Outlined)"
                             Color="@(SelectedDays.Contains(DayOfWeek.Sunday) ? Color.Primary : Color.Default)"
                             OnClick="() => ToggleDay(DayOfWeek.Sunday)"
                             DisableRipple="true"
                             Class="habit-day-chip"
                             Size="Size.Small">Ndz</MudChip>
                </MudChipSet>
                @if (Model.DaysOfWeekMask == 0)
                {
                    <MudText Color="Color.Error" Typo="Typo.caption">Musisz wybrać przynajmniej jeden dzień tygodnia</MudText>
                }

                <MudDatePicker @bind-Date="Model.DeadlineDateTime"
                               Label="Termin (opcjonalny)"
                               Editable="true"
                               Clearable="true"
                               MinDate="@DateTime.Today"
                               For="@(() => Model.DeadlineDateTime)" />

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@ErrorMessage</MudAlert>
                }

                <ValidationSummary />
            </MudStack>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton OnClick="HandleCancel" 
                           Disabled="@IsSubmitting">
                    Anuluj
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(IsSubmitting || Model.DaysOfWeekMask == 0)">
                    @if (IsSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ml-2">Zapisywanie...</MudText>
                    }
                    else
                    {
                        <text>@(Mode == FormMode.Create ? "Utwórz" : "Zapisz")</text>
                    }
                </MudButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>

<style>
    .habit-day-chip:focus,
    .habit-day-chip:focus-visible,
    .habit-day-chip:active {
        box-shadow: none;
        outline: none;
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public FormMode Mode { get; set; } = FormMode.Create;

    [Parameter]
    public HabitFormModel Model { get; set; } = new();

    [Parameter]
    public EventCallback<HabitFormModel> OnSubmit { get; set; }

    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }
    
    private HashSet<DayOfWeek> SelectedDays { get; set; } = new();
    private DateTime? DeadlineDate { get; set; }

    protected override void OnInitialized()
    {
        // Initialize selected days from mask
        SelectedDays = GetDaysFromMask(Model.DaysOfWeekMask);
        
        // Initialize deadline date
        DeadlineDate = Model.DeadlineDate?.ToDateTime(TimeOnly.MinValue);
    }

    private void OnCompletionModeChanged(CompletionMode newMode)
    {
        Model.CompletionMode = newMode;
        if (newMode == CompletionMode.Binary)
        {
            Model.TargetValue = null;
            Model.TargetUnit = null;
        }
        else if (Model.TargetValue == null)
        {
            Model.TargetValue = 1;
        }
    }

    protected override void OnParametersSet()
    {
        // Update deadline date
        if (DeadlineDate.HasValue)
        {
            Model.DeadlineDate = DateOnly.FromDateTime(DeadlineDate.Value);
            Model.ClearDeadline = false;
        }
        else
        {
            Model.DeadlineDate = null;
            Model.ClearDeadline = Mode == FormMode.Edit; // Only set ClearDeadline flag in edit mode
        }
    }

    private async Task HandleSubmit()
    {
        ErrorMessage = null;
        IsSubmitting = true;
        
        try
        {
            // Final validation of days
            Model.DaysOfWeekMask = GetMaskFromDays(SelectedDays);
            
            if (Model.DaysOfWeekMask == 0)
            {
                ErrorMessage = "Musisz wybrać przynajmniej jeden dzień tygodnia";
                return;
            }

            await OnSubmit.InvokeAsync(Model);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Wystąpił błąd: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void HandleCancel()
    {
        MudDialog?.Cancel();
    }

    private void ToggleDay(DayOfWeek day)
    {
        if (!SelectedDays.Add(day))
        {
            SelectedDays.Remove(day);
        }

        Model.DaysOfWeekMask = GetMaskFromDays(SelectedDays);
    }

    private static byte GetMaskFromDays(IEnumerable<DayOfWeek> days)
    {
        byte mask = 0;
        foreach (var day in days)
        {
            mask |= (byte)(1 << GetBitIndex(day));
        }
        return mask;
    }

    private static HashSet<DayOfWeek> GetDaysFromMask(int mask)
    {
        var days = new HashSet<DayOfWeek>();
        for (int i = 0; i < 7; i++)
        {
            if ((mask & (1 << i)) != 0)
            {
                days.Add(GetDayOfWeek(i));
            }
        }
        return days;
    }

    private static int GetBitIndex(DayOfWeek dayOfWeek)
    {
        // Mask: Monday=0, Tuesday=1, ..., Sunday=6
        return dayOfWeek == DayOfWeek.Sunday ? 6 : (int)dayOfWeek - 1;
    }

    private static DayOfWeek GetDayOfWeek(int bitIndex)
    {
        // Mask: Monday=0, Tuesday=1, ..., Sunday=6
        return bitIndex == 6 ? DayOfWeek.Sunday : (DayOfWeek)(bitIndex + 1);
    }

    public enum FormMode
    {
        Create,
        Edit
    }
}
