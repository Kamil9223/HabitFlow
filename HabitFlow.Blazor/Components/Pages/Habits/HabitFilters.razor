@using HabitFlow.Blazor.Components.Pages.Habits.Models
@using HabitFlow.Client
@using SortDirection = HabitFlow.Client.SortDirection

<MudPaper Elevation="0" Class="pa-4 mb-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_searchText"
                          Label="Szukaj"
                          Placeholder="Wpisz tytuł nawyku..."
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentIconClickable="true"
                          OnAdornmentClick="HandleSearchCommit"
                          OnBlur="HandleSearchCommit"
                          Disabled="@IsBusy"
                          Style="min-width: 250px; flex: 1;" />

            <MudSelect @bind-Value="Filters.Type"
                       @bind-Value:after="OnFilterChanged"
                       Label="Typ"
                       Clearable="true"
                       Disabled="@IsBusy"
                       T="HabitType?"
                       Style="min-width: 150px;">
                <MudSelectItem Value="@((HabitType?)null)">Wszystkie</MudSelectItem>
                <MudSelectItem Value="@((HabitType?)HabitType.Start)">Build</MudSelectItem>
                <MudSelectItem Value="@((HabitType?)HabitType.Stop)">Stop</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="Filters.CompletionMode"
                       @bind-Value:after="OnFilterChanged"
                       Label="Tryb"
                       Clearable="true"
                       Disabled="@IsBusy"
                       T="CompletionMode?"
                       Style="min-width: 150px;">
                <MudSelectItem Value="@((CompletionMode?)null)">Wszystkie</MudSelectItem>
                <MudSelectItem Value="@((CompletionMode?)CompletionMode.Binary)">Binary</MudSelectItem>
                <MudSelectItem Value="@((CompletionMode?)CompletionMode.Quantitative)">Quantitative</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="Filters.Active"
                       @bind-Value:after="OnFilterChanged"
                       Label="Status"
                       Clearable="true"
                       Disabled="@IsBusy"
                       T="bool?"
                       Style="min-width: 150px;">
                <MudSelectItem Value="@((bool?)null)">Wszystkie</MudSelectItem>
                <MudSelectItem Value="@((bool?)true)">Aktywne</MudSelectItem>
                <MudSelectItem Value="@((bool?)false)">Archiwalne</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="Filters.SortField"
                       @bind-Value:after="OnFilterChanged"
                       Label="Sortuj według"
                       Disabled="@IsBusy"
                       T="HabitSortField"
                       Style="min-width: 180px;">
                <MudSelectItem Value="@HabitSortField.CreatedAtUtc">Data utworzenia</MudSelectItem>
                <MudSelectItem Value="@HabitSortField.Title">Tytuł</MudSelectItem>
                <MudSelectItem Value="@HabitSortField.DeadlineDate">Deadline</MudSelectItem>
            </MudSelect>

            <MudToggleIconButton Toggled="@_sortAscending"
                                 ToggledChanged="OnSortDirectionChanged"
                                 Icon="@Icons.Material.Filled.ArrowDownward"
                                 ToggledIcon="@Icons.Material.Filled.ArrowUpward"
                                 Title="@(_sortAscending ? "Sortowanie rosnąco" : "Sortowanie malejąco")"
                                 ToggledTitle="Sortowanie rosnąco"
                                 Disabled="@IsBusy" />

            <MudButton OnClick="HandleClearFilters"
                       StartIcon="@Icons.Material.Filled.Clear"
                       Variant="Variant.Outlined"
                       Disabled="@IsBusy">
                Wyczyść
            </MudButton>
        </MudStack>

        @if (HasActiveFilters)
        {
            <MudChipSet T="string">
                @if (Filters.Type is HabitType type)
                {
                    <MudChip T="string"
                             OnClose="() => ClearFilter(() => Filters.Type = null)"
                             Color="Color.Primary"
                             Size="Size.Small">
                        Typ: @type
                    </MudChip>
                }
                @if (Filters.CompletionMode is CompletionMode completionMode)
                {
                    <MudChip T="string"
                             OnClose="() => ClearFilter(() => Filters.CompletionMode = null)"
                             Color="Color.Primary"
                             Size="Size.Small">
                        Tryb: @completionMode
                    </MudChip>
                }
                @if (Filters.Active is bool isActive)
                {
                    <MudChip T="string"
                             OnClose="() => ClearFilter(() => Filters.Active = null)"
                             Color="Color.Primary"
                             Size="Size.Small">
                        Status: @(isActive ? "Aktywne" : "Archiwalne")
                    </MudChip>
                }
                @if (!string.IsNullOrWhiteSpace(Filters.Search))
                {
                    <MudChip T="string"
                             OnClose="() => ClearFilter(() => Filters.Search = null)"
                             Color="Color.Primary"
                             Size="Size.Small">
                        Szukaj: "@Filters.Search"
                    </MudChip>
                }
            </MudChipSet>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public HabitListFilterVm Filters { get; set; } = new();

    [Parameter]
    public EventCallback<HabitListFilterVm> OnFiltersChanged { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private string? _searchText;
    private bool _sortAscending;

    private bool HasActiveFilters =>
        Filters.Type.HasValue ||
        Filters.CompletionMode.HasValue ||
        Filters.Active.HasValue ||
        !string.IsNullOrWhiteSpace(Filters.Search);

    protected override void OnInitialized()
    {
        _searchText = Filters.Search;
        _sortAscending = Filters.SortDirection == SortDirection.Asc;
    }

    protected override void OnParametersSet()
    {
        // Sync search text with filters
        if (_searchText != Filters.Search)
        {
            _searchText = Filters.Search;
        }

        // Sync sort direction
        _sortAscending = Filters.SortDirection == SortDirection.Asc;

    }

    private void OnSortDirectionChanged(bool ascending)
    {
        _sortAscending = ascending;
        Filters.SortDirection = ascending ? SortDirection.Asc : SortDirection.Desc;
        Filters.Page = 1;
        NotifyFiltersChanged();
    }
    
    private async Task OnFilterChanged()
    {
        Filters.Page = 1;
        await NotifyFiltersChanged();
    }
    
    private async Task HandleClearFilters()
    {
        Filters.Reset();
        _searchText = null;
        _sortAscending = false;
        await NotifyFiltersChanged();
    }

    private async Task ClearFilter(Action clearAction)
    {
        clearAction();
        Filters.Page = 1;
        
        if (clearAction.Target?.ToString()?.Contains("Search") == true)
        {
            _searchText = null;
        }
        
        await NotifyFiltersChanged();
    }

    private async Task NotifyFiltersChanged()
    {
        await OnFiltersChanged.InvokeAsync(Filters);
    }

    private async Task HandleSearchCommit()
    {
        var trimmedSearch = _searchText?.Trim();
        if (string.IsNullOrWhiteSpace(trimmedSearch))
        {
            trimmedSearch = null;
        }

        if (trimmedSearch == Filters.Search)
        {
            return;
        }

        Filters.Search = trimmedSearch;
        Filters.Page = 1;
        await NotifyFiltersChanged();
    }
}
