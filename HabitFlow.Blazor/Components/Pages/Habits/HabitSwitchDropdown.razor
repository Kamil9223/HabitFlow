@using HabitFlow.Blazor.Components.Pages.Habits.Models

<MudMenu Icon="@Icons.Material.Filled.SwapHoriz"
         Color="Color.Default"
         Variant="Variant.Outlined"
         Size="Size.Small"
         Dense="true"
         AnchorOrigin="Origin.BottomLeft">
    <ActivatorContent>
        <MudTooltip Text="Przełącz na inny nawyk">
            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz"
                          Color="Color.Default"
                          Size="Size.Small" />
        </MudTooltip>
    </ActivatorContent>
    <ChildContent>
        @foreach (var habit in AllHabits)
        {
            <MudMenuItem OnClick="@(() => HandleChange(habit.Id))"
                        Disabled="@(habit.Id == SelectedHabitId)">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    @if (habit.Id == SelectedHabitId)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Size="Size.Small" />
                    }
                    <MudText>@habit.Title</MudText>
                </MudStack>
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired]
    public int SelectedHabitId { get; set; }

    [Parameter, EditorRequired]
    public List<HabitListItemVm> AllHabits { get; set; } = new();

    [Parameter]
    public EventCallback<int> OnChange { get; set; }

    private async Task HandleChange(int newHabitId)
    {
        if (newHabitId != SelectedHabitId)
        {
            await OnChange.InvokeAsync(newHabitId);
        }
    }
}
