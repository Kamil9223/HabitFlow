@page "/auth/forgot-password"
@layout AuthLayout
@using HabitFlow.Blazor.Components.Layout
@using HabitFlow.Client
@inject IHabitFlowApiClient ApiClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Resetowanie hasła - HabitFlow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
                Resetowanie hasła
            </MudText>

            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Podaj adres email powiązany z Twoim kontem
            </MudText>

            @if (_state.IsSuccess)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Jeśli konto istnieje, wysłaliśmy link do resetowania hasła na podany adres email. Sprawdź swoją skrzynkę pocztową.
                </MudAlert>

                <MudButton
                    Variant="Variant.Text"
                    Color="Color.Primary"
                    FullWidth="true"
                    Href="/auth/login">
                    Powrót do logowania
                </MudButton>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_state.ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-2">
                        @_state.ErrorMessage
                    </MudAlert>
                }

                <EditForm Model="_model" OnValidSubmit="HandleForgotPasswordAsync">
                    <DataAnnotationsValidator />

                    <MudStack Spacing="3">
                        <MudTextField
                            @bind-Value="_model.Email"
                            Label="Email"
                            Variant="Variant.Outlined"
                            InputType="InputType.Email"
                            Required="true"
                            RequiredError="Email jest wymagany"
                            Disabled="_state.IsSubmitting"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Email" />

                        <MudButton
                            ButtonType="ButtonType.Submit"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            FullWidth="true"
                            Size="Size.Large"
                            Disabled="_state.IsSubmitting">
                            @if (_state.IsSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Wysyłanie...</span>
                            }
                            else
                            {
                                <span>Wyślij link resetujący</span>
                            }
                        </MudButton>
                    </MudStack>
                </EditForm>

                <MudDivider Class="my-2" />

                <MudText Typo="Typo.body2" Align="Align.Center">
                    Pamiętasz hasło?
                    <MudLink Href="/auth/login" Color="Color.Primary">Zaloguj się</MudLink>
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private ForgotPasswordFormModel _model = new();
    private ForgotPasswordState _state = new();

    private async Task HandleForgotPasswordAsync()
    {
        // Reset errors
        _state.ErrorMessage = null;

        // Client-side validation
        if (!ValidateForm())
        {
            StateHasChanged();
            return;
        }

        _state.IsSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new ForgotPasswordRequest
            {
                Email = _model.Email!
            };

            await ApiClient.ForgotPasswordAsync(request, CancellationToken.None);

            // Always show success to prevent user enumeration
            _state.IsSuccess = true;
        }
        catch (ApiException ex) when (ex.StatusCode == 400)
        {
            _state.ErrorMessage = "Niepoprawny format adresu email.";
        }
        catch (ApiException)
        {
            _state.ErrorMessage = "Wystąpił błąd podczas wysyłania linku. Spróbuj ponownie później.";
        }
        catch (HttpRequestException ex)
        {
            _state.ErrorMessage = $"Nie można połączyć się z API: {ex.Message}";
        }
        catch (Exception ex)
        {
            _state.ErrorMessage = $"Wystąpił nieoczekiwany błąd: {ex.Message}";
        }
        finally
        {
            _state.IsSubmitting = false;
            StateHasChanged();
        }
    }

    private bool ValidateForm()
    {
        var isValid = true;

        // Email validation
        if (string.IsNullOrWhiteSpace(_model.Email))
        {
            _state.ErrorMessage = "Email jest wymagany";
            isValid = false;
        }
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_model.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            _state.ErrorMessage = "Niepoprawny format adresu email";
            isValid = false;
        }

        return isValid;
    }

    // ViewModels
    private class ForgotPasswordFormModel
    {
        public string? Email { get; set; }
    }

    private class ForgotPasswordState
    {
        public bool IsSubmitting { get; set; }
        public bool IsSuccess { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
