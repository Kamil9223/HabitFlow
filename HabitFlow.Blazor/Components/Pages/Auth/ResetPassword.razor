@page "/auth/reset-password"
@layout AuthLayout
@using HabitFlow.Blazor.Components.Layout
@using HabitFlow.Client
@inject IHabitFlowApiClient ApiClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Ustaw nowe hasło - HabitFlow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
                Ustaw nowe hasło
            </MudText>

            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Wprowadź nowe hasło dla swojego konta
            </MudText>

            @if (_state.IsSuccess)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Hasło zostało pomyślnie zresetowane! Możesz się teraz zalogować.
                </MudAlert>

                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth="true"
                    Href="/auth/login">
                    Przejdź do logowania
                </MudButton>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_state.ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-2">
                        @_state.ErrorMessage
                    </MudAlert>
                }

                <EditForm Model="_model" OnValidSubmit="HandleResetPasswordAsync">
                    <DataAnnotationsValidator />

                    <MudStack Spacing="3">
                        <MudTextField
                            @bind-Value="_model.NewPassword"
                            Label="Nowe hasło"
                            Variant="Variant.Outlined"
                            InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                            Required="true"
                            RequiredError="Hasło jest wymagane"
                            Disabled="_state.IsSubmitting"
                            Adornment="Adornment.End"
                            AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                            OnAdornmentClick="TogglePasswordVisibility"
                            HelperText="Min. 8 znaków, wielka litera, mała litera, cyfra" />

                        <MudTextField
                            @bind-Value="_model.ConfirmPassword"
                            Label="Potwierdź hasło"
                            Variant="Variant.Outlined"
                            InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                            Required="true"
                            RequiredError="Potwierdzenie hasła jest wymagane"
                            Disabled="_state.IsSubmitting"
                            Adornment="Adornment.End"
                            AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                            OnAdornmentClick="TogglePasswordVisibility" />

                        <MudButton
                            ButtonType="ButtonType.Submit"
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            FullWidth="true"
                            Size="Size.Large"
                            Disabled="_state.IsSubmitting">
                            @if (_state.IsSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Resetowanie...</span>
                            }
                            else
                            {
                                <span>Zresetuj hasło</span>
                            }
                        </MudButton>
                    </MudStack>
                </EditForm>

                <MudDivider Class="my-2" />

                <MudText Typo="Typo.body2" Align="Align.Center">
                    Pamiętasz hasło?
                    <MudLink Href="/auth/login" Color="Color.Primary">Zaloguj się</MudLink>
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private ResetPasswordFormModel _model = new();
    private ResetPasswordState _state = new();
    private bool _showPassword;

    private string? _email;
    private string? _token;

    protected override void OnInitialized()
    {
        // Extract email and token from query parameters
        var uri = new Uri(Navigation.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _email = queryParams["email"];
        _token = queryParams["token"];

        // Validate that we have the required parameters
        if (string.IsNullOrEmpty(_email) || string.IsNullOrEmpty(_token))
        {
            _state.ErrorMessage = "Nieprawidłowy link resetowania hasła. Spróbuj ponownie z linku otrzymanego w email.";
        }
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task HandleResetPasswordAsync()
    {
        // Check if we have required parameters
        if (string.IsNullOrEmpty(_email) || string.IsNullOrEmpty(_token))
        {
            _state.ErrorMessage = "Nieprawidłowy link resetowania hasła.";
            StateHasChanged();
            return;
        }

        // Reset errors
        _state.ErrorMessage = null;

        // Client-side validation
        if (!ValidateForm())
        {
            StateHasChanged();
            return;
        }

        _state.IsSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new ResetPasswordRequest
            {
                Email = _email,
                Token = _token,
                NewPassword = _model.NewPassword!
            };

            await ApiClient.ResetPasswordAsync(request, CancellationToken.None);

            // Success
            _state.IsSuccess = true;
        }
        catch (ApiException ex) when (ex.StatusCode == 400)
        {
            // Could be invalid token or password validation errors
            _state.ErrorMessage = "Link resetowania hasła wygasł lub jest nieprawidłowy. Spróbuj ponownie zażądać resetowania hasła.";
        }
        catch (ApiException)
        {
            _state.ErrorMessage = "Wystąpił błąd podczas resetowania hasła. Spróbuj ponownie później.";
        }
        catch (HttpRequestException ex)
        {
            _state.ErrorMessage = $"Nie można połączyć się z API: {ex.Message}";
        }
        catch (Exception ex)
        {
            _state.ErrorMessage = $"Wystąpił nieoczekiwany błąd: {ex.Message}";
        }
        finally
        {
            _state.IsSubmitting = false;
            StateHasChanged();
        }
    }

    private bool ValidateForm()
    {
        var isValid = true;

        // Password validation
        if (string.IsNullOrWhiteSpace(_model.NewPassword))
        {
            _state.ErrorMessage = "Hasło jest wymagane";
            isValid = false;
        }
        else if (_model.NewPassword.Length < 8)
        {
            _state.ErrorMessage = "Hasło musi mieć co najmniej 8 znaków";
            isValid = false;
        }
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_model.NewPassword, @"[A-Z]"))
        {
            _state.ErrorMessage = "Hasło musi zawierać co najmniej jedną wielką literę";
            isValid = false;
        }
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_model.NewPassword, @"[a-z]"))
        {
            _state.ErrorMessage = "Hasło musi zawierać co najmniej jedną małą literę";
            isValid = false;
        }
        else if (!System.Text.RegularExpressions.Regex.IsMatch(_model.NewPassword, @"\d"))
        {
            _state.ErrorMessage = "Hasło musi zawierać co najmniej jedną cyfrę";
            isValid = false;
        }

        // Confirm password validation
        if (string.IsNullOrWhiteSpace(_model.ConfirmPassword))
        {
            _state.ErrorMessage = "Potwierdzenie hasła jest wymagane";
            isValid = false;
        }
        else if (_model.NewPassword != _model.ConfirmPassword)
        {
            _state.ErrorMessage = "Hasła nie są identyczne";
            isValid = false;
        }

        return isValid;
    }

    // ViewModels
    private class ResetPasswordFormModel
    {
        public string? NewPassword { get; set; }
        public string? ConfirmPassword { get; set; }
    }

    private class ResetPasswordState
    {
        public bool IsSubmitting { get; set; }
        public bool IsSuccess { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
