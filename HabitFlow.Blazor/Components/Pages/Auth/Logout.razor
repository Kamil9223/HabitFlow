@page "/auth/logout"
@layout AuthLayout
@using HabitFlow.Blazor.Components.Layout
@using HabitFlow.Client
@inject IHabitFlowApiClient ApiClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Wylogowanie - HabitFlow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudStack Spacing="3" AlignItems="AlignItems.Center">
            @if (_state.IsLoading)
            {
                <MudProgressCircular Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Wylogowywanie...
                </MudText>
            }
            else if (_state.IsSuccess)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Zostales poprawnie wylogowany.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/auth/login">
                    Przejdz do logowania
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    @_state.ErrorMessage
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/auth/login">
                    Przejdz do logowania
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private LogoutState _state = new();

    protected override async Task OnInitializedAsync()
    {
        _state.IsLoading = true;

        try
        {
            await ApiClient.LogoutAsync(CancellationToken.None);
            _state.IsSuccess = true;
        }
        catch (ApiException)
        {
            _state.ErrorMessage = "Wystapil blad podczas wylogowania.";
        }
        catch (HttpRequestException ex)
        {
            _state.ErrorMessage = $"Nie mozna polaczyc sie z API: {ex.Message}";
        }
        catch (Exception ex)
        {
            _state.ErrorMessage = $"Wystapil nieoczekiwany blad: {ex.Message}";
        }
        finally
        {
            _state.IsLoading = false;
        }
    }

    private sealed class LogoutState
    {
        public bool IsLoading { get; set; }
        public bool IsSuccess { get; set; }
        public string ErrorMessage { get; set; } = "Nie udalo sie wylogowac.";
    }
}
