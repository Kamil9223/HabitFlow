@page "/auth/logout"
@layout AuthLayout
@using HabitFlow.Blazor.Components.Layout
@inject IConfiguration Configuration
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Wylogowanie - HabitFlow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudStack Spacing="3" AlignItems="AlignItems.Center">
            @if (_state.IsLoading)
            {
                <MudProgressCircular Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Wylogowywanie...
                </MudText>
            }
            else if (_state.IsSuccess)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Zostales poprawnie wylogowany.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/auth/login">
                    Przejdz do logowania
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    @_state.ErrorMessage
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/auth/login">
                    Przejdz do logowania
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private LogoutState _state = new();

    protected override async Task OnInitializedAsync()
    {
        _state.IsLoading = true;

        try
        {
            var apiBaseUrl = Configuration["Api:BaseUrl"];
            if (string.IsNullOrWhiteSpace(apiBaseUrl))
            {
                _state.ErrorMessage = "Brak konfiguracji Api:BaseUrl.";
                return;
            }

            var result = await JsRuntime.InvokeAsync<AuthResult>(
                "habitFlowAuth.logout",
                apiBaseUrl);

            if (result.Ok)
            {
                _state.IsSuccess = true;
            }
            else
            {
                _state.ErrorMessage = result.Status switch
                {
                    401 => "Sesja wygasła. Zaloguj się ponownie.",
                    _ => string.IsNullOrWhiteSpace(result.Message)
                        ? "Wystąpił błąd podczas wylogowania."
                        : result.Message
                };
            }
        }
        catch (Exception ex)
        {
            _state.ErrorMessage = $"Wystapil nieoczekiwany blad: {ex.Message}";
        }
        finally
        {
            _state.IsLoading = false;
        }
    }

    private sealed class LogoutState
    {
        public bool IsLoading { get; set; }
        public bool IsSuccess { get; set; }
        public string ErrorMessage { get; set; } = "Nie udalo sie wylogowac.";
    }

    private sealed class AuthResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Message { get; set; }
    }
}
