@page "/notifications"
@using HabitFlow.Blazor.Components.Pages.Notifications.Models
@using HabitFlow.Blazor.Components.Pages.Notifications.Helpers
@using HabitFlow.Client
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject IHabitFlowApiClient ApiClient
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Powiadomienia - HabitFlow</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h4">Powiadomienia</MudText>

        @if (!string.IsNullOrWhiteSpace(_state.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Filled"
                      CloseIconClicked="() => _state.ErrorMessage = null"
                      ShowCloseIcon="true">
                @_state.ErrorMessage
            </MudAlert>
        }

        <NotificationsList Items="@_state.Items"
                          TotalCount="@_state.TotalCount"
                          CurrentPage="@_state.CurrentPage"
                          PageSize="@_state.PageSize"
                          IsLoading="@_state.IsLoading"
                          OnPageChanged="HandlePageChanged"
                          OnPageSizeChanged="HandlePageSizeChanged" />
    </MudStack>
</MudContainer>
